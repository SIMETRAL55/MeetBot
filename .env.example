# ============================================================================
# MeetBot — Environment Variable Reference
#
# Copy this file to .env and fill in the required values.
# Variables with defaults can be left commented out.
# ============================================================================


# ============================================================================
# REQUIRED — Secrets (no default; missing values cause auth failures)
# ============================================================================

# JWT signing key — MUST be set in production or tokens are lost on restart
WEB_SECRET_KEY=<generate-a-random-32-char-secret>

# NiceGUI user-storage encryption key
WEB_STORAGE_SECRET=<generate-a-random-32-char-secret>


# ============================================================================
# HuggingFace (required for diarization + HF inference API)
# ============================================================================

# HuggingFace API token (for pyannote gated models + HF Inference API)
HF_API_TOKEN=<your-huggingface-token>

# Deprecated aliases (keep for LangChain compatibility if needed)
# HF_HUB_TOKEN=<your-huggingface-token>
# HUGGINGFACEHUB_API_TOKEN=<your-huggingface-token>


# ============================================================================
# Transcription Backend
# ============================================================================

# Backend: 'huggingface' (API, default), 'local' (CPU Whisper), 'faster-whisper' (GPU)
# TRANSCRIPTION_BACKEND=huggingface

# Model size for local/faster-whisper backends (tiny|base|small|medium|large-v2|large-v3)
# RTX 3050 4 GB: use 'small' or 'medium'
# WHISPER_MODEL_SIZE=small

# HuggingFace Whisper model ID (HF API backend only)
# WHISPER_MODEL=openai/whisper-large-v3

# Pyannote diarization model
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Default language hint for Whisper (e.g. 'en', 'ja'). Unset = auto-detect.
# DEFAULT_LANGUAGE=


# ============================================================================
# LLM for RAG Generation
# ============================================================================

# HuggingFace model ID for Inference API
# HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# Inference provider ('auto' = first live provider for the model)
# HF_PROVIDER=auto

# Use local AWQ model instead of HF API
# USE_LOCAL_LLM=false

# Path to local AWQ model directory
# LOCAL_LLM_MODEL_PATH=./models/qwen2.5-1.5B

# Local LLM generation settings
# LOCAL_LLM_CONTEXT_SIZE=2048
# LOCAL_LLM_MAX_TOKENS=128
# LOCAL_LLM_TEMPERATURE=0.7


# ============================================================================
# Embedding & Vector Retrieval
# ============================================================================

# Local embedding model path or HuggingFace model ID
# EMBEDDING_MODEL=./models/all-MiniLM-L6-v2

# Device for embedding model ('cuda' or 'cpu')
# EMBEDDING_DEVICE=cuda

# ChromaDB collection name
# VECTOR_DB_COLLECTION_NAME=meetbot

# RAG retrieval settings
# RAG_RECALL_N=50          # ANN candidates before reranking
# RAG_TOP_K=4              # Final top-K after reranking
# RAG_MAX_CONTEXT_CHUNKS=6 # Max chunks fed to the LLM
# SOURCE_SIM_THRESHOLD=0.30
# SOURCE_MAX_RETURN=5

# Chunking settings
# CHUNK_TOKENS=300
# CHUNK_OVERLAP=50


# ============================================================================
# Database
# ============================================================================

# SQLite database path
# DB_PATH=./db/meetbot.db

# PostgreSQL (overrides DB_PATH when set)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/meetbot

# ChromaDB path
# VECTOR_DB_PATH=./db/sample


# ============================================================================
# File Storage & I/O
# ============================================================================

# Output directories
# OUTPUT_DIR=./results
# PREPARED_DOCS_DIR=./prepared
# TEMP_DIR=./temp
# CACHE_DIR=./.cache_hf

# PageIndex JSON tree output directory
# PAGEINDEX_OUTPUT_DIR=./db/pageindex

# Max upload size (MB)
# MAX_UPLOAD_SIZE_MB=500

# Allowed audio file extensions (comma-separated)
# ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.flac,.aac,.ogg,.wma,.opus


# ============================================================================
# Audio Chunking (for large files)
# ============================================================================

# AUDIO_CHUNK_ENABLE=true
# AUDIO_CHUNK_SIZE_BYTES=104857600   # 100 MB threshold
# AUDIO_CHUNK_OVERLAP_SECONDS=1.0
# AUDIO_CHUNK_NOMINAL_DURATION=120.0
# AUDIO_CHUNK_USE_SILENCE_DETECTION=true


# ============================================================================
# PageIndex (vectorless LLM tree-search — optional)
# ============================================================================

# Enable PageIndex feature
# PAGEINDEX_ENABLED=false

# Auto-build PageIndex during pipeline ingestion (Stage 4b)
# PAGEINDEX_AUTO_INDEX=false

# LLM backend:
#   'vertexai'    — Vertex AI via gcloud Application Default Credentials (recommended; no API key)
#   'google'      — Google AI Studio via API key
#   'openrouter'  — OpenRouter (free models available)
#   'openai'      — OpenAI
#   'ollama'/'local' — local Ollama server
# PAGEINDEX_LLM_BACKEND=vertexai

# Vertex AI settings (required when PAGEINDEX_LLM_BACKEND=vertexai)
# Authenticate first: gcloud auth application-default login
# VERTEXAI_PROJECT=<your-gcp-project-id-or-number>
# VERTEXAI_LOCATION=us-central1

# API key (required for 'google' and 'openrouter' backends; not used for 'vertexai')
# PAGEINDEX_LLM_API_KEY=<your-api-key>

# Model ID for PageIndex LLM calls
# Vertex AI:         google/gemini-2.5-flash
# Google AI Studio:  gemini-2.0-flash
# OpenRouter (free): nvidia/nemotron-3-super-120b-a12b:free
# PAGEINDEX_LLM_MODEL=google/gemini-2.5-flash

# Custom base URL (leave empty to auto-resolve from PAGEINDEX_LLM_BACKEND)
# PAGEINDEX_LLM_BASE_URL=

# Path to local HuggingFace model directory (Ollama backend only)
# PAGEINDEX_LLM_MODEL_PATH=

# Max tokens per tree node during indexing
# PAGEINDEX_MAX_PAGE_TOKENS=20000


# ============================================================================
# Web Server
# ============================================================================

# CORS origin for Next.js frontend
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# Rate limiting (slowapi format, per IP)
# RATE_LIMIT_UPLOAD=10/hour
# RATE_LIMIT_CHAT=60/minute


# ============================================================================
# Pipeline Workers
# ============================================================================

# Max concurrent pipeline jobs (keep at 1 for GPU-constrained machines)
# PIPELINE_WORKERS=1


# ============================================================================
# Memory-safe Indexing
# ============================================================================

# EMBED_BATCH_SIZE=32
# INDEX_BATCH_PERSIST_CHECKPOINT=100
# MEMORY_WATCH_ENABLED=true
# MEMORY_WATCH_THRESHOLD_PCT=0.85
# RAG_MEMORY_SAFE_MODE=true


# ============================================================================
# Device
# ============================================================================

# Compute device: 'cuda', 'cpu', or leave unset for auto-detection
# DEVICE=

# Authentication setup for otp
# SMTP — required for OTP emails                                               
# SMTP_HOST=smtp.gmail.com                                                       
# SMTP_PORT=587                                                                  
# SMTP_USER=your-email@gmail.com                                                 
# SMTP_PASSWORD=your-app-password                                                
# SMTP_FROM=your-email@gmail.com    